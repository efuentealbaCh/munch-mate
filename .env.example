# Copy to .env with `pnpm env:init` (generates every __SECRET__ value). Never commit .env.
# Secrets are hex on purpose: they go into URLs (MONGODB_URI, VALKEY_URL) and must not need escaping.

# ── General ───────────────────────────────────────────────────────────────────
# localhost = test the production stack locally (Caddy local CA). On the VPS: the real domain.
DOMAIN=localhost
# Image names: <REGISTRY>/<app>:<TAG>. On the VPS, e.g. REGISTRY=ghcr.io/efuentealbach/munch-mate and TAG=<git sha>.
REGISTRY=munch-mate
TAG=local
LOG_LEVEL=info

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=__HEX_24__
MONGO_DB=munchmate
MONGO_APP_USER=munchmate_app
MONGO_APP_PASSWORD=__HEX_24__

# ── Valkey ────────────────────────────────────────────────────────────────────
VALKEY_PASSWORD=__HEX_24__

# ── Garage (S3) ───────────────────────────────────────────────────────────────
GARAGE_RPC_SECRET=__HEX_32__
GARAGE_ADMIN_TOKEN=__HEX_32__
# Disk space Garage may use on this node.
GARAGE_CAPACITY=10G
S3_REGION=garage
# Private bucket (PDFs and anything not public).
S3_BUCKET=munchmate
# Public bucket served through Garage's website endpoint (menu photos, logos).
S3_MEDIA_BUCKET=munchmate-media
# Garage key format: "GK" + 24 hex chars, secret = 64 hex chars.
S3_ACCESS_KEY_ID=GK__HEX_12__
S3_SECRET_ACCESS_KEY=__HEX_32__

# ── Auth ──────────────────────────────────────────────────────────────────────
# Rotating it logs every user out within 15 minutes (access tokens are short-lived).
JWT_ACCESS_SECRET=__HEX_32__
# Derives order tracking links; rotating it invalidates the links of existing orders.
ORDER_TOKEN_SECRET=__HEX_32__

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Dev: Mailpit (UI at http://localhost:8025). `pnpm stack:up` overrides host/port with its own Mailpit.
# VPS: your provider's SMTP, e.g. SMTP_HOST=smtp.provider.com SMTP_PORT=587 SMTP_USER=... SMTP_PASS=...
SMTP_HOST=localhost
SMTP_PORT=1025
# true only for implicit TLS (port 465); 587 upgrades with STARTTLS automatically.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Munch Mate <no-reply@munchmate.local>"

# Web push (phase 6, optional: empty = no push notifications). Generate the pair with `pnpm push:keys`,
# which writes them here in your .env. The subject is a contact for the push services (mailto: or https:).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@munchmate.local

# ── Apps running on the host (`pnpm dev`) ─────────────────────────────────────
# Containers build their own URLs in compose.yaml; these are only read by the apps in dev.
# The browser talks to Next.js (3100), which proxies /api to the api (3000): same origin, like Caddy in prod.
APP_URL=http://localhost:3100
# directConnection=true: the replica set advertises "mongo:27017", which does not resolve outside Docker.
MONGODB_URI="mongodb://${MONGO_APP_USER}:${MONGO_APP_PASSWORD}@localhost:27017/${MONGO_DB}?authSource=${MONGO_DB}&directConnection=true"
VALKEY_URL=redis://:${VALKEY_PASSWORD}@localhost:6379
S3_ENDPOINT=http://localhost:3900
# Where browsers load media from. Containers use https://media.<DOMAIN> (built in compose.yaml).
MEDIA_PUBLIC_URL=http://munchmate-media.web.garage.localhost:3902
