    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/mongoose": "^12.0.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "bullmq": "^6.3.11",
    "ioredis": "^6.0.0",
    "mongoose": "^9.10.4",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^10.0.15",
    "pdfkit": "^0.20.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
