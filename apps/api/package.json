{
  "name": "@app/api",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nest build -p tsconfig.build.json",
    "dev": "nest start --watch -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.js",
    "test:int": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.int.config.js --runInBand --passWithNoTests",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.e2e.config.js --runInBand"
  },
  "dependencies": {
    "@app/types": "workspace:*",
    "@app/utils": "workspace:*",
    "@aws-sdk/client-s3": "^3.1146.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.11",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "ioredis": "^6.0.0",
    "mongoose": "^9.10.4",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
